{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phone Numbers - Vonage",
    "version": "v1.1.1"
  },
  "items": [
    {
      "info": {
        "name": "account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List owned numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-prd.kpn.com/communication/nexmo/phone-numbers/account/numbers",
            "params": [
              {
                "name": "index",
                "value": "",
                "type": "query",
                "description": "Page index"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              },
              {
                "name": "pattern",
                "value": "",
                "type": "query",
                "description": "A number pattern to search for."
              },
              {
                "name": "search_pattern",
                "value": "",
                "type": "query",
                "description": "Strategy for matching pattern. Expected values: 0 (starts with, default), 1 (anywhere), 2 (ends with)."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve all the inbound numbers associated with your Vonage account."
        }
      ]
    },
    {
      "info": {
        "name": "number",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search available numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-prd.kpn.com/communication/nexmo/phone-numbers/number/search",
            "params": [
              {
                "name": "country",
                "value": "",
                "type": "query"
              },
              {
                "name": "pattern",
                "value": "",
                "type": "query",
                "description": "A number pattern to search for."
              },
              {
                "name": "search_pattern",
                "value": "",
                "type": "query",
                "description": "Strategy for matching pattern. Expected values: 0 (starts with, default), 1 (anywhere), 2 (ends with)."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "The type of number to search for. By default it takes landline."
              },
              {
                "name": "features",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              },
              {
                "name": "index",
                "value": "",
                "type": "query",
                "description": "Page index"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve inbound numbers that are available for a given country."
        },
        {
          "info": {
            "name": "Buy a number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-prd.kpn.com/communication/nexmo/phone-numbers/number/buy",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Request to purchase a specific inbound number."
        },
        {
          "info": {
            "name": "Cancel a number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-prd.kpn.com/communication/nexmo/phone-numbers/number/cancel",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Cancel your subscription for a specific inbound number."
        },
        {
          "info": {
            "name": "Update a number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-prd.kpn.com/communication/nexmo/phone-numbers/number/update",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Change the behaviour of a number that you own"
        }
      ]
    }
  ],
  "bundled": true
}
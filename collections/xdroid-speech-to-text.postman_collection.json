  "item": [
    {
      "id": "481ce554-fb29-4a0a-8937-36c32c919570",
      "name": "Upload audio",
      "description": {
        "content": "Uploads an audio file and start a new analytics job.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "65db493a-eec6-47a9-b5cd-ad446bd76eac",
          "name": "Submits audio files for analyis.",
          "request": {
            "name": "Submits audio files for analyis.",
            "description": {
              "content": "To create a new transcript use the following recommendations: \n+ Accepted container formats:\n  - .wav\n  - .mp3 / .mp4\n  - .opus / .ogg\n  \n+ Preferred requirements:\n  - Bitrate: 64 Kbit/s per channel (stero recording is supported)\n  - Sample rate: 8 KHz\n  - Uncompressed files preferred\n\n+ Max audio file size: 150 MB.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "job"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "config",
                  "value": "<object>",
                  "type": "text",
                  "description": "A JSON object defining the language of the audio file. For example: \n\n`{\"language\":\"en\",\"recording_start\":\"20201119121111\" }` or\n`{\"language\":\"en\",\"recording_start\":\"\" }`\n\nBody parameter | Description\n---------------|----------------------\n`language` | The parameter `language` is required in ISO language code. Supported language codes: </br> Global English: `en` </br> Global Spanish: `es` </br> Dutch: `nl` </br> French: `fr `</br> Example: `{\"language\":\"en\"}`\n`recording_start` | Day and time when the recording starts. Optional </br> Format: `YmdHis`. Example: `20201216081228`\n"
                },
                {
                  "key": "audio_file",
                  "type": "file",
                  "description": "Attach the audio file to be transcribed. Requirements see above."
                }
              ]
            }
          },
          "response": [
            {
              "id": "501e3e9e-b201-45da-b1ed-02a7aa7a51c3",
              "name": "OK",
              "originalRequest": {

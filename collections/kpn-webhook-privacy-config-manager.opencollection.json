{
  "opencollection": "1.0.0",
  "info": {
    "name": "Webhook Privacy Configuration - KPN",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization webhook config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/organizations"
          },
          "docs": "Returns the webhook configuration for your organization, including any\nactive field exclusion rules and signing key status.\n\nThe organization config record is created automatically when the first\norg-level signing key is provisioned or when the first webhook delivery\nis processed for your organization.\n"
        },
        {
          "info": {
            "name": "Update organization privacy config",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/organizations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the org-level field exclusion settings. All teams and applications\nin your organization inherit these settings unless they define their own.\n\nTo manage signing keys, use the [Webhook Signing Keys API](#tag/Organization-Keys).\n"
        }
      ]
    },
    {
      "info": {
        "name": "Team",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get team webhook config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/teams"
          },
          "docs": "Returns the current webhook configuration for your team."
        },
        {
          "info": {
            "name": "Create team webhook config",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/teams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates the webhook configuration for your team, including the URL\nwhere KPN will deliver outbound webhook notifications and any\nfield exclusion rules.\n"
        },
        {
          "info": {
            "name": "Update team webhook config",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/teams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the webhook URL and/or field exclusion settings for your team."
        },
        {
          "info": {
            "name": "Delete team webhook config",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/teams"
          },
          "docs": "Permanently removes the team webhook configuration. Webhook deliveries\nwill fall back to any configured org-level settings.\n"
        }
      ]
    },
    {
      "info": {
        "name": "Application",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get application webhook config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/applications",
            "headers": [
              {
                "name": "x-application-name",
                "value": ""
              }
            ]
          },
          "docs": "Returns the current webhook configuration for your application."
        },
        {
          "info": {
            "name": "Create application webhook config",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/applications",
            "headers": [
              {
                "name": "x-application-name",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates the webhook configuration for a specific application in your\nteam. Application settings take highest precedence and override team\nand org settings.\n"
        },
        {
          "info": {
            "name": "Update application webhook config",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/applications",
            "headers": [
              {
                "name": "x-application-name",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the webhook URL and/or field exclusion settings for your application."
        },
        {
          "info": {
            "name": "Delete application webhook config",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://virtserver.swaggerhub.com/kpn/webhook-config-management-kpn/2.0.0/applications"
          },
          "docs": "Permanently removes the application webhook configuration. Webhook\ndeliveries for this application will fall back to team-level settings.\n"
        }
      ]
    }
  ],
  "bundled": true
}
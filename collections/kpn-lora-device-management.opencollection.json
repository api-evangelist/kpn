      "items": [
        {
          "info": {
            "name": "Retrieves frame statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-prd.kpn.com/data/lora/thingpark/deviceFrameStatistics",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "deviceEUIList",
                "value": "",
                "type": "query",
                "description": "List of device EUIs for which device statistics should be retrieved."
              },
              {
                "name": "baseStationId",
                "value": "",
                "type": "query",
                "description": "Id of the base station which received the frame."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date in ISO 8601 format of the period for which frame statistics should be retrieved. By default, only the last frame statistics resource is retrieved."
              },
              {
                "name": "duration",
                "value": "",
                "type": "query",
                "description": "Period (number of days) for which frame statistics should be retrieved. By default, the default duration is 7 days."
              },
              {
                "name": "aggregationStep",
                "value": "",
                "type": "query",
                "description": "Number of hours (between 1 and 24) used for aggregating the frame statistics. By default, all frame statistics are returned (no aggregation)."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves frame statistics of the devices corresponding to the provided parameters, if those devices are within authorized scopes."

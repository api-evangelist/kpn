{
  "opencollection": "1.0.0",
  "info": {
    "name": "Internet Speed Check - KPN",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "default",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "get info",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-prd.kpn.com/network/kpn/internet-speed-check/offer",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "API Version. If no version is provided it defaults to latest version."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves the information about internet connection and technology for the given address identified by postcode, house number and house extension"
        }
      ]
    }
  ],
  "bundled": true
}
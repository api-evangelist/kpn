{
  "opencollection": "1.0.0",
  "info": {
    "name": "Disturbance Check - KPN",
    "version": "v1.1.1"
  },
  "items": [
    {
      "info": {
        "name": "default",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "get info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-prd.kpn.com/network/kpn/disturbance-check/address",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "zip_code",
                "value": "",
                "type": "query",
                "description": "Zip code of the address. Format `1111AR`."
              },
              {
                "name": "house_number",
                "value": "",
                "type": "query",
                "description": "House number of the address."
              },
              {
                "name": "house_number_extension",
                "value": "",
                "type": "query",
                "description": "House number extension of the address."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken?grant_type=client_credentials",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves the information about internet connection and technology for the given address identified by postcode, house number and house extension."
        }
      ]
    }
  ],
  "bundled": true
}